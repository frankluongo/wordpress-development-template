# Local environment for this project.
# `npm run setup` copies this file to .env and fills in the values.
# Never commit .env.

# --- Project -----------------------------------------------------------------

# Docker Compose project name. Must be unique per project on this machine.
COMPOSE_PROJECT_NAME=starter
# Local HTTPS domain. Subdomains hmr., mail. and db. are created alongside it.
SITE_DOMAIN=starter.test
# Site title used for a fresh install.
SITE_TITLE="Starter"
# Project theme and plugin folder names under wp-content/. Leave one empty if the
# project has only a theme or only a plugin.
THEME_SLUG=starter-theme
PLUGIN_SLUG=starter-plugin

# --- Versions (match production; see docs/guides/matching-production.md) ------

# PHP version for the php-fpm image (e.g. 8.1, 8.2, 8.3, 8.4). Run `npm run up` after changing.
PHP_VERSION=8.3
# WordPress core version. Leave empty to use "core" from wp-dependencies.json.
WP_VERSION=
# WP-CLI version baked into the php image.
WP_CLI_VERSION=2.12.0
# Database engine (mariadb or mysql) and image tag.
DB_IMAGE=mariadb
DB_VERSION=10.11

# --- Database ----------------------------------------------------------------

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
# Table prefix. Updated automatically by `npm run db:import`.
TABLE_PREFIX=wp_

# --- Local admin (created on install, reset after every import) ---------------

LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_EMAIL=admin@starter.test

# --- Client database import ----------------------------------------------------

# Production URL, used when it can't be detected from the dump's siteurl.
PRODUCTION_URL=
# Missing media is redirected here. Set by `npm run db:import`; empty disables it.
UPLOADS_PROXY_URL=
# Comma-separated plugin slugs deactivated after every import.
LOCAL_DEACTIVATE_PLUGINS=wp-rocket,w3-total-cache,wp-super-cache,litespeed-cache,wordfence,sucuri-scanner,wp-mail-smtp,updraftplus,jetpack
# Also look in ~/Downloads for the newest import file.
IMPORT_SCAN_DOWNLOADS=true
# Number of pre-import backups kept in .db/backups.
DB_BACKUPS_KEEP=10

# --- PHP -----------------------------------------------------------------------

# Xdebug mode: off, debug, develop, profile, trace, coverage (comma-separated).
XDEBUG_MODE=off
PHP_UPLOAD_MAX=256M
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300

# --- Asset dev server --------------------------------------------------------------

# Host port for `npm run dev`. Must be unique per project on this machine.
DEV_SERVER_PORT=8887
# Set to a millisecond interval (e.g. 500) if file changes aren't picked up.
WATCH_POLL=

# --- SSH database pull (optional, `npm run db:pull <env>`) ---------------------------

# REMOTE_PRODUCTION_SSH=user@example.com
# REMOTE_PRODUCTION_PATH=/var/www/html
# REMOTE_PRODUCTION_URL=https://example.com

# --- Salts (generated by setup) ------------------------------------------------------

WP_AUTH_KEY=
WP_SECURE_AUTH_KEY=
WP_LOGGED_IN_KEY=
WP_NONCE_KEY=
WP_AUTH_SALT=
WP_SECURE_AUTH_SALT=
WP_LOGGED_IN_SALT=
WP_NONCE_SALT=
