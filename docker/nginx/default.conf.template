# WordPress on nginx + PHP-FPM, following common managed-host conventions (R2.5).
# Rendered by the nginx image's envsubst; only variables set in compose.yaml are replaced.

server {
	listen 80 default_server;
	server_name _;

	root /var/www/html;
	index index.php;

	client_max_body_size ${PHP_UPLOAD_MAX};

	gzip on;
	gzip_vary on;
	gzip_proxied any;
	gzip_comp_level 5;
	gzip_min_length 256;
	gzip_types application/javascript application/json application/xml image/svg+xml text/css text/plain text/xml;

	# Optional fragments rendered by `npm run up` (e.g. the production uploads proxy).
	# Included first so their locations win over the static-file rule below.
	include /etc/nginx/includes/*.conf;

	location = /favicon.ico {
		log_not_found off;
		access_log off;
		try_files $uri /index.php?$args;
	}

	location = /robots.txt {
		log_not_found off;
		access_log off;
		try_files $uri /index.php?$args;
	}

	# Dotfiles (except .well-known), XML-RPC, and PHP inside uploads.
	location ~ /\.(?!well-known) {
		deny all;
	}

	location = /xmlrpc.php {
		deny all;
	}

	location ~* /(?:uploads|files)/.*\.php$ {
		deny all;
	}

	location / {
		try_files $uri $uri/ /index.php?$args;
	}

	location ~ \.php$ {
		try_files $uri =404;
		fastcgi_split_path_info ^(.+\.php)(/.+)$;
		include fastcgi_params;
		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
		fastcgi_param HTTPS on;
		fastcgi_pass php:9000;
		fastcgi_read_timeout ${PHP_MAX_EXECUTION_TIME};
		fastcgi_buffers 16 16k;
		fastcgi_buffer_size 32k;
	}

	location ~* \.(?:css|js|mjs|map|json|jpe?g|gif|png|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|pdf)$ {
		access_log off;
		log_not_found off;
		add_header Cache-Control "no-cache";
		try_files $uri =404;
	}
}
