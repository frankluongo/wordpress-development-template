<?xml version="1.0"?>
<ruleset name="Project">
	<description>WordPress Coding Standards for the project theme and plugin (R9.1).</description>

	<file>wp-content/themes</file>
	<file>wp-content/plugins</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- PHP version: `npm run lint` sets testVersion from PHP_VERSION in .env. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="minimum_wp_version" value="6.8"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Renamed by `npm run setup`. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="starter-theme"/>
				<element value="starter-plugin"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="starter_theme"/>
				<element value="starter_plugin"/>
				<element value="StarterTheme"/>
				<element value="StarterPlugin"/>
			</property>
		</properties>
	</rule>

	<!-- Classes use PSR-4 file names (Theme.php), not WordPress's class-theme.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/inc/*</exclude-pattern>
		<exclude-pattern>*/src/*</exclude-pattern>
	</rule>
</ruleset>
